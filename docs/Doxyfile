PROJECT_NAME           = "humanoid-core"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Vendor-independent C++20 humanoid robotics framework"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = README.md include common/include plugins/include ros2/include cloud/include docs
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.md
EXCLUDE                = third_party build build-* docs/doxygen
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HAVE_DOT               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
QUIET                  = YES
