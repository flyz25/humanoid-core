@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(HUMANOID_CORE_VERSION "@PROJECT_VERSION@")
set(HUMANOID_CORE_VERSION_PRERELEASE "@HUMANOID_CORE_VERSION_PRERELEASE@")
set(HUMANOID_CORE_SEMANTIC_VERSION "@HUMANOID_CORE_SEMANTIC_VERSION@")

if(@HUMANOID_CORE_CONFIG_REQUIRES_UNITREE_SDK2@)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(UnitreeSDK2 MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/humanoid_coreTargets.cmake")

check_required_components(humanoid_core)
